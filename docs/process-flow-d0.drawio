<mxfile host="Electron"><diagram id="d0" name="Intake to Pre-Review"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="S1" value="Scout submits Proposal on the intake page&lt;br&gt;details + files" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dbeafe;strokeColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="76" y="27" width="190" height="64" as="geometry"/></mxCell><mxCell id="T1" value="Files go to the _Intake Queue folder&lt;br&gt;Intake Queue row: Unconfirmed&lt;br&gt;one confirmation link emailed per address" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="76" y="205" width="190" height="84" as="geometry"/></mxCell><mxCell id="D1" value="Link clicked&lt;br&gt;before it expires?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dbeafe;strokeColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="86" y="414" width="170" height="140" as="geometry"/></mxCell><mxCell id="P1" value="Stays Unconfirmed&lt;br&gt;purged after 14 days from the menu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="76" y="710" width="190" height="64" as="geometry"/></mxCell><mxCell id="D2" value="Duplicate check" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="350" y="672" width="170" height="140" as="geometry"/></mxCell><mxCell id="A1" value="Exact match on one record, and the clicker's&lt;br&gt;address is on that record:&lt;br&gt;files attached as new versions" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="185" y="933" width="190" height="84" as="geometry"/></mxCell><mxCell id="H1" value="Held as Possible duplicate&lt;br&gt;Scout told; committee emailed full details" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="495" y="943" width="190" height="64" as="geometry"/></mxCell><mxCell id="C0" value="Committee decides:&lt;br&gt;Promote, or Mark spam" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="495" y="1131" width="190" height="64" as="geometry"/></mxCell><mxCell id="T2" value="Promote: Scout folder, standard file names,&lt;br&gt;row added, Life to Eagle Log started,&lt;br&gt;receipt emailed to Scout + parent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="495" y="1321" width="190" height="84" as="geometry"/></mxCell><mxCell id="ST1" value="Something missing&lt;br&gt;today = also 'waiting for Intake Check'" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f3f4f6;strokeColor=#111827;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="1528" width="200" height="70" as="geometry"/></mxCell><mxCell id="F1" value="PROPOSED new section: Intake Check&lt;br&gt;holding state for the cursory review" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#6b7280;dashed=1;dashPattern=6 4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="779" y="1528" width="200" height="70" as="geometry"/></mxCell><mxCell id="C1" value="Intake Check&lt;br&gt;Advancement Chair or a member" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="650" y="1712" width="170" height="140" as="geometry"/></mxCell><mxCell id="F2" value="PROPOSED: AI first look&lt;br&gt;missing signatures, pages, fields&lt;br&gt;human in the loop" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fo